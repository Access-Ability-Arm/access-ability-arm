# Access Ability Arm Configuration
# Copy this file to config.yaml and customize for your setup

# Robotic Arm Settings
arm:
  # Arm type: "lite6" (UFactory Lite6, TCP/IP) or "b601" (Seeed reBot Arm B601, serial/CAN)
  type: "lite6"

  # --- UFactory Lite6 settings (used when type = "lite6") ---
  # IP address of your Lite6 arm (find in xArm Studio or network settings)
  ip: "192.168.1.203"

  # Port number (default: 502 for Modbus TCP)
  port: 502

  # Auto-connect on startup
  auto_connect: true

  # --- Seeed reBot Arm B601 settings (used when type = "b601") ---
  # Serial port connected to the B601 CAN adapter
  # Linux: "/dev/ttyACM0"   Windows: "COM3"
  b601_port: "/dev/ttyACM0"

  # --- Camera-to-gripper (tool) mount calibration ---
  #
  # Physical constant of the hardware.  Change only if the camera is
  # physically detached and remounted.  Does NOT change when the arm
  # is repositioned in the room.
  #
  # COORDINATE FRAMES (all right-handed):
  #
  #   Gripper tool frame:
  #     +X  rightward across the gripper face (when facing the jaw opening)
  #     +Y  upward along the gripper body
  #     +Z  forward, out through the jaw opening (approach / grasp direction)
  #
  #   Camera frame (RealSense D435 standard):
  #     +X  rightward in the camera image
  #     +Y  downward in the camera image
  #     +Z  into the scene (depth / optical axis)
  #
  # TRANSLATION  tx / ty / tz  (millimetres)
  #   Vector from gripper tip origin to camera lens origin, expressed in
  #   the gripper tool frame.
  #   +tx  camera is to the right  of the gripper tip
  #   +ty  camera is above          the gripper tip
  #   +tz  camera is further forward (farther from the arm, closer to object)
  #
  # ROTATION  roll / pitch / yaw  (degrees)
  #   Intrinsic RPY: rotate the camera frame onto the gripper tool frame by
  #   applying roll first, then pitch about the already-rotated Y axis, then
  #   yaw about the already-rotated Z axis.  Right-hand rule throughout
  #   (curl fingers in the positive direction; thumb points along +axis).
  #   +roll   tilts the top of the camera toward gripper +X (rightward)
  #   +pitch  tilts the camera face upward (away from the floor)
  #   +yaw    rotates the camera face toward gripper -X (leftward)
  #
  # EXAMPLE — camera mounted 40 mm above and 20 mm behind the gripper tip,
  # tilted 30° downward to see the object below:
  #   camera_to_tool_tx_mm:  0.0
  #   camera_to_tool_ty_mm: 40.0
  #   camera_to_tool_tz_mm: -20.0
  #   camera_to_tool_pitch: -30.0   (negative = face tilts downward)
  #
  camera_to_tool_tx_mm: 0.0   # camera right of gripper tip (mm, +X gripper)
  camera_to_tool_ty_mm: 0.0   # camera above gripper tip    (mm, +Y gripper)
  camera_to_tool_tz_mm: 0.0   # camera forward of gripper tip (mm, +Z gripper)
  camera_to_tool_roll:  0.0   # +roll  = camera top tilts right  (degrees)
  camera_to_tool_pitch: 0.0   # +pitch = camera face tilts up    (degrees)
  camera_to_tool_yaw:   0.0   # +yaw   = camera face turns left  (degrees)

# Camera Settings
camera:
  # Maximum number of cameras to check on startup
  max_cameras_to_check: 3

  # Default camera index (0 = first camera)
  default_camera: 0

  # Skip cameras matching these patterns (optional)
  # Cameras with names containing these strings will be excluded
  # Examples: ["iPhone", "ckphone", "Continuity"]
  skip_cameras: []

# Object Detection Settings
detection:
  # Confidence threshold for object detection (0.0 - 1.0)
  # Lower = more detections but more false positives
  # Higher = fewer detections but more accurate
  threshold: 0.5

  # YOLOv11 model size: n (nano), s (small), m (medium), l (large), x (xlarge)
  # Larger models are more accurate but slower
  yolo_model_size: "x"

  # Spatial smoothing settings (morphological operations)
  # Smooths segmentation mask boundaries for stable grasp planning
  spatial_smoothing:
    # Enable/disable spatial smoothing (default: true)
    enabled: true

    # Kernel shape: ellipse (best for rounded objects), rectangle, or cross
    kernel_shape: "ellipse"

    # Kernel sizes for different object sizes (pixels)
    small_object_kernel: 3   # Objects < 1% of frame
    medium_object_kernel: 5  # Objects 1-10% of frame
    large_object_kernel: 7   # Objects > 10% of frame

    # Number of smoothing iterations (1-3 recommended)
    # More iterations = smoother boundaries but more processing time
    iterations: 2

  # Temporal tracking settings (ByteTrack)
  # Maintains object identity across frames for stable grasp planning
  temporal_tracking:
    # Enable/disable temporal tracking (default: true)
    enabled: true

    # High-confidence detection threshold (0.0-1.0, default: 0.6)
    # Higher values reduce false positives for stationary objects
    track_thresh: 0.6

    # Track buffer: frames to keep lost tracks (default: 60 = 2 sec @ 30fps)
    # High value compensates for detector inconsistency
    track_buffer: 60

    # IoU threshold for matching detections (0.0-1.0, default: 0.7)
    match_thresh: 0.7

    # Exponential moving average alpha (0.0-1.0, default: 0.97)
    # High value (0.95-0.98) for stationary scenes, lower (0.8-0.9) for moving objects
    smoothing_alpha: 0.97

  # Depth validation settings (RealSense depth-based boundary validation)
  # Uses lightweight Sobel gradient detection (<2ms overhead)
  depth_validation:
    # Enable/disable depth validation (default: true)
    enabled: true

    # Depth discontinuity threshold in meters (default: 0.03 = 3cm)
    # Smaller = more sensitive to edges, Larger = only major discontinuities
    discontinuity_threshold: 0.03

    # Minimum confidence for validated boundaries (0.0-1.0, default: 0.5)
    min_confidence: 0.5

    # Edge dilation iterations (default: 1)
    # Larger = thicker edge regions for matching with RGB boundaries
    edge_dilation: 1

    # Use bilateral filter on depth before edge detection (default: true)
    # Reduces noise while preserving edges
    use_bilateral_filter: true

# Control Settings
controls:
  # Button hold threshold in seconds
  # Press shorter = tap action, press longer = hold action
  button_hold_threshold: 0.5

  # Movement step sizes in millimeters
  tap_step_size: 10    # Short button press
  hold_step_size: 50   # Long button press

  # Movement speed in mm/s
  movement_speed: 100

  # Gripper speed in pulse/s
  gripper_speed: 5000

# Display Settings
display:
  # Video feed dimensions
  width: 800
  height: 650

  # Window startup size
  window_width: 1230
  window_height: 695
